{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drawscope.local/contracts/v1/drawing.schema.json",
  "title": "Drawing",
  "type": "object",
  "additionalProperties": false,
  "required": ["draw_date", "main_numbers", "special_number", "multiplier"],
  "properties": {
    "draw_date": { "type": "string", "format": "date" },
    "main_numbers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer" }
    },
    "special_number": { "type": ["integer", "null"] },
    "multiplier": { "type": ["integer", "null"], "minimum": 1 }
  }
}
