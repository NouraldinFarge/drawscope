{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drawscope.local/contracts/v1/engine-event.schema.json",
  "title": "EngineEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "job_id",
    "attempt_id",
    "sequence_number",
    "occurred_at",
    "type",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "message_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "attempt_id": { "type": "string", "format": "uuid" },
    "sequence_number": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "type": {
      "enum": ["analysis_started", "analysis_progress", "analysis_completed", "job_failed"]
    },
    "payload": { "type": "object" }
  }
}
