{
  "name": "drawscope-workspace",
  "version": "0.6.3",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @drawscope/desktop build",
    "check": "tsc -b --pretty false",
    "clean:generated": "pwsh -NoProfile -File tools/clean-generated.ps1",
    "contracts:test": "vitest run packages/contracts/tests",
    "dev": "pnpm --filter @drawscope/desktop tauri dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test",
    "tauri": "pnpm --filter @drawscope/desktop tauri"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
