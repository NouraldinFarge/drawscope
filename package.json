{
  "name": "drawscope-workspace",
  "version": "0.6.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @drawscope/desktop build",
    "check": "tsc -b --pretty false",
    "clean:generated": "pwsh -NoProfile -File tools/clean-generated.ps1",
    "contracts:test": "vitest run packages/contracts/tests",
    "dev": "pnpm --filter @drawscope/desktop tauri dev",
    "docs:check": "node scripts/check-documentation.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "presentation:check": "node scripts/sync-presentation.mjs",
    "presentation:sync": "node scripts/sync-presentation.mjs --write",
    "site:build": "node scripts/build-site.mjs",
    "test": "vitest run",
    "verify": "pnpm presentation:check && pnpm site:build && pnpm docs:check && pnpm format:check && pnpm lint && pnpm check && pnpm test",
    "tauri": "pnpm --filter @drawscope/desktop tauri"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "nanoid@<3.3.17": "3.3.18"
    }
  }
}
