{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DrawScope",
  "version": "0.6.3",
  "identifier": "com.drawscope.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'"
    },
    "windows": [
      {
        "title": "DrawScope",
        "label": "main",
        "width": 1320,
        "height": 840,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": [],
    "createUpdaterArtifacts": false
  }
}
